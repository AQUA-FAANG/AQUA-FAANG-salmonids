# macOS / editor cruft
.DS_Store

# knitr / rmarkdown caches, figure scratch and rendered notebook output
*_cache/
*_files/
figure/
*.html

# R session leftovers and the default plot device
.RData
.Rhistory
.Rproj.user/
Rplots.pdf

# recompute-mode regenerated assets (the deposited *_norm/_unit_* are never
# overwritten; the re-derived copies land beside them with a _regen suffix)
*_regen.tsv.gz
*_regen.txt
*_regen.rds

# transcriptome-analysis — local download cache and regenerated figure outputs
transcriptome-analysis/cache/
transcriptome-analysis/results/

# transcriptome-analysis — GO tables regenerated by 06_go.Rmd
transcriptome-analysis/compareCluster_*.csv

# transcriptome-analysis — OrgDB annotation packages built locally by 99a/99b
transcriptome-analysis/org.Ssalar.eg.db/
transcriptome-analysis/org.Omykiss.eg.db/

# chromatin-accesibility-clustering-and-visualization — local working state:
# the knitr cache, the derived per-context matrices and the rendered results.
# The two deposited consensus-expression tables under data/atac/ ARE shipped
# (the inputs that reproduce the figures); any other data/atac/ scratch is
# ignored. The data/atac_soms/ SOM assets are tracked (no ignore rule needed).
chromatin-accesibility-clustering-and-visualization/data/atac/*
!chromatin-accesibility-clustering-and-visualization/data/atac/AtlanticSalmon_consensus_expression.rds
!chromatin-accesibility-clustering-and-visualization/data/atac/RainbowTrout_consensus_expression.rds
chromatin-accesibility-clustering-and-visualization/data/derived/
chromatin-accesibility-clustering-and-visualization/cache/
chromatin-accesibility-clustering-and-visualization/results/
